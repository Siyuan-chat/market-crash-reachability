import Mathlib.Tactic

/-! Kernel soundness of exact rational interval operations only.
No ODE certificate is assumed or asserted by these arithmetic lemmas. -/
namespace MarketCrash
namespace RationalInterval

structure Box where
  lo : ℚ
  hi : ℚ
deriving DecidableEq

def Contains (I : Box) (x : ℝ) : Prop := (I.lo : ℝ) ≤ x ∧ x ≤ I.hi
def point (q : ℚ) : Box := ⟨q, q⟩
def add (I J : Box) : Box := ⟨I.lo + J.lo, I.hi + J.hi⟩
def neg (I : Box) : Box := ⟨-I.hi, -I.lo⟩
def mul (I J : Box) : Box :=
  ⟨min (min (I.lo * J.lo) (I.lo * J.hi)) (min (I.hi * J.lo) (I.hi * J.hi)),
   max (max (I.lo * J.lo) (I.lo * J.hi)) (max (I.hi * J.lo) (I.hi * J.hi))⟩
def inv (I : Box) : Box := ⟨1 / I.hi, 1 / I.lo⟩
def containsBox (I J : Box) : Bool := decide (I.lo ≤ J.lo ∧ J.hi ≤ I.hi)

theorem point_sound (q : ℚ) : Contains (point q) (q : ℝ) := ⟨le_rfl, le_rfl⟩
theorem add_sound {I J : Box} {x y : ℝ} (hx : Contains I x) (hy : Contains J y) :
    Contains (add I J) (x + y) := by
  dsimp [Contains, add] at *
  push_cast
  constructor <;> linarith

theorem neg_sound {I : Box} {x : ℝ} (hx : Contains I x) : Contains (neg I) (-x) := by
  dsimp [Contains, neg] at *
  push_cast
  constructor <;> linarith

theorem linear_mul_bounds {a b x y : ℝ} (hx : a ≤ x ∧ x ≤ b) :
    min (a * y) (b * y) ≤ x * y ∧ x * y ≤ max (a * y) (b * y) := by
  by_cases hy : 0 ≤ y
  · exact ⟨(min_le_left _ _).trans (mul_le_mul_of_nonneg_right hx.1 hy),
      (mul_le_mul_of_nonneg_right hx.2 hy).trans (le_max_right _ _)⟩
  · have hn := le_of_not_ge hy
    exact ⟨(min_le_right _ _).trans (mul_le_mul_of_nonpos_right hx.2 hn),
      (mul_le_mul_of_nonpos_right hx.1 hn).trans (le_max_left _ _)⟩

theorem mul_sound {I J : Box} {x y : ℝ} (hx : Contains I x) (hy : Contains J y) :
    Contains (mul I J) (x * y) := by
  have hxy := linear_mul_bounds (y := y) hx
  have ha := linear_mul_bounds (y := (I.lo : ℝ)) hy
  have hb := linear_mul_bounds (y := (I.hi : ℝ)) hy
  dsimp [Contains, mul]
  push_cast
  simp only [mul_comm y (I.lo : ℝ), mul_comm (J.lo : ℝ) (I.lo : ℝ),
    mul_comm (J.hi : ℝ) (I.lo : ℝ)] at ha
  simp only [mul_comm y (I.hi : ℝ), mul_comm (J.lo : ℝ) (I.hi : ℝ),
    mul_comm (J.hi : ℝ) (I.hi : ℝ)] at hb
  constructor
  · exact (min_le_min ha.1 hb.1).trans hxy.1
  · exact hxy.2.trans (max_le_max ha.2 hb.2)

theorem inv_sound {I : Box} {x : ℝ} (hlo : 0 < I.lo) (hx : Contains I x) :
    Contains (inv I) (1 / x) := by
  have hl : (0 : ℝ) < I.lo := by exact_mod_cast hlo
  have hp : 0 < x := hl.trans_le hx.1
  dsimp [Contains, inv]
  push_cast
  exact ⟨one_div_le_one_div_of_le hp hx.2, one_div_le_one_div_of_le hl hx.1⟩

theorem containsBox_sound {I J : Box} {x : ℝ} (hc : containsBox I J = true)
    (hx : Contains J x) : Contains I x := by
  have hh : I.lo ≤ J.lo ∧ J.hi ≤ I.hi := of_decide_eq_true hc
  have hl : (I.lo : ℝ) ≤ J.lo := by exact_mod_cast hh.1
  have hu : (J.hi : ℝ) ≤ I.hi := by exact_mod_cast hh.2
  exact ⟨hl.trans hx.1, hx.2.trans hu⟩

/-- The fixed-point grid uses exact floor/ceil directed outwards. -/
def roundOut (Q : ℕ) (I : Box) : Box :=
  ⟨((⌊I.lo * Q⌋ : ℤ) : ℚ) / Q, ((⌈I.hi * Q⌉ : ℤ) : ℚ) / Q⟩

theorem roundOut_sound {I : Box} {x : ℝ} (Q : ℕ) (hQ : 0 < Q) (hx : Contains I x) :
    Contains (roundOut Q I) x := by
  have hQq : (0 : ℚ) < Q := by exact_mod_cast hQ
  have hl : (((⌊I.lo * Q⌋ : ℤ) : ℚ) / Q) ≤ I.lo :=
    (div_le_iff₀ hQq).mpr (Int.floor_le _)
  have hu : I.hi ≤ (((⌈I.hi * Q⌉ : ℤ) : ℚ) / Q) :=
    (le_div_iff₀ hQq).mpr (Int.le_ceil _)
  have hlr : ((((⌊I.lo * Q⌋ : ℤ) : ℚ) / Q) : ℝ) ≤ I.lo := by exact_mod_cast hl
  have hur : (I.hi : ℝ) ≤ ((((⌈I.hi * Q⌉ : ℤ) : ℚ) / Q) : ℝ) := by exact_mod_cast hu
  dsimp [Contains, roundOut]
  push_cast
  exact ⟨hlr.trans hx.1, hx.2.trans hur⟩

theorem rounded_mul_sound {I J : Box} {x y : ℝ} (Q : ℕ) (hQ : 0 < Q)
    (hx : Contains I x) (hy : Contains J y) :
    Contains (roundOut Q (mul I J)) (x * y) := roundOut_sound Q hQ (mul_sound hx hy)

theorem rounded_inv_sound {I : Box} {x : ℝ} (Q : ℕ) (hQ : 0 < Q)
    (hlo : 0 < I.lo) (hx : Contains I x) :
    Contains (roundOut Q (inv I)) (1 / x) := roundOut_sound Q hQ (inv_sound hlo hx)

namespace CertificateReplay

def grid : ℕ := 10 ^ 32
def rat (q : ℚ) : Box := roundOut grid (point q)
def times (I J : Box) : Box := roundOut grid (mul I J)
def divide (I J : Box) : Box := times I (roundOut grid (inv J))
def subtract (I J : Box) : Box := add I (neg J)
def rho : Box := rat (2 / 5)
def dt : Box := rat (1 / 2000)
def magnitude (I : Box) : ℚ := max |I.lo| |I.hi|
def hull (I J : Box) : Box := ⟨min I.lo J.lo, max I.hi J.hi⟩

structure Segment where
  x₀ : Box
  velocity : Box
  error : Box

def prepare (x₀ x₁ : Box) (duration : ℚ) : Segment := Id.run do
  let v := divide (subtract x₁ x₀) (rat duration)
  let xs := hull x₀ x₁
  let urange := times xs (add v (times rho (subtract xs (rat 1))))
  let uder := times v (add v (times rho (subtract (times (rat 2) xs) (rat 1))))
  let M := magnitude urange
  let D := magnitude uder
  let B := 9 * D / (7 / 10) + (2 / 5 + 9 * M / (49 / 100)) *
    (6 / 25 + 9 * M / (7 / 10))
  return ⟨x₀, v, times (times (rat (B / 2)) dt) dt⟩

def field (s : Segment) (j : ℕ) (y : Box) : Box := Id.run do
  let x := add s.x₀ (times s.velocity (rat ((j : ℚ) / 2000)))
  let u := times x (add s.velocity (times rho (subtract x (rat 1))))
  return subtract (neg (times rho (subtract y (rat 1)))) (divide (times (rat 9) u) y)

structure State where
  enclosure : Box
  valid : Bool

/-- Exact rational counterpart of a single fixed-point integer step.
No claim that this executable checker has passed is built into the definition. -/
def step (s : Segment) (j : ℕ) (state : State) : State := Id.run do
  let l := point state.enclosure.lo
  let u := point state.enclosure.hi
  let low := (subtract (add l (times dt (field s j l))) s.error).lo
  let high := (add (add u (times dt (field s j u))) s.error).hi
  let motion := (times (rat (17 / 10)) dt).hi
  let lb := min state.enclosure.lo low - motion
  let hb := max state.enclosure.hi high + motion
  let valid := state.valid && decide (low ≤ high) &&
    decide (73 / 100 < state.enclosure.lo) && decide (state.enclosure.hi < 157 / 100) &&
    decide (7 / 10 < lb) && decide (hb < 8 / 5)
  return ⟨⟨low, high⟩, valid⟩

def run (s : Segment) : ℕ → ℕ → State → State
  | 0, _, state => state
  | n + 1, j, state => run s n (j + 1) (step s j state)

def plateau : Box := ⟨102020225507905 / 100000000000000,
  102020225507908 / 100000000000000⟩

def fullReplay : State := Id.run do
  let mut state := State.mk (point 1) true
  state := run (prepare (rat 1) plateau (23 / 10)) 4600 0 state
  state := run (prepare plateau plateau (77 / 5)) 30800 0 state
  state := run (prepare plateau (rat (97 / 100)) (23 / 10)) 4600 0 state
  state := run (prepare (rat (97 / 100)) (rat (199 / 200)) (23 / 10)) 4600 0 state
  state := run (prepare (rat (199 / 200)) (rat (199 / 200)) (77 / 5)) 30800 0 state
  return run (prepare (rat (199 / 200)) (rat (9409 / 10000)) (23 / 10)) 4600 0 state

theorem grid_pos : 0 < grid := by norm_num [grid]

theorem rat_sound (q : ℚ) : Contains (rat q) (q : ℝ) :=
  roundOut_sound grid grid_pos (point_sound q)

theorem times_sound {I J : Box} {x y : ℝ} (hx : Contains I x) (hy : Contains J y) :
    Contains (times I J) (x * y) := rounded_mul_sound grid grid_pos hx hy

theorem divide_sound {I J : Box} {x y : ℝ} (hlo : 0 < J.lo)
    (hx : Contains I x) (hy : Contains J y) : Contains (divide I J) (x / y) := by
  simpa only [divide, div_eq_mul_inv, one_div, one_mul] using
    times_sound hx (rounded_inv_sound grid grid_pos hlo hy)

theorem subtract_sound {I J : Box} {x y : ℝ} (hx : Contains I x) (hy : Contains J y) :
    Contains (subtract I J) (x - y) := by
  simpa only [sub_eq_add_neg] using add_sound hx (neg_sound hy)

/-- Numerical endpoint field evaluation encloses the actual scalar field for
every root/velocity selected from the prepared parameter intervals. -/
theorem field_sound (s : Segment) (j : ℕ) (Y : Box) (x₀ v y : ℝ)
    (hx₀ : Contains s.x₀ x₀) (hv : Contains s.velocity v)
    (hy : Contains Y y) (hY : 0 < Y.lo) :
    Contains (field s j Y)
      (-(2 / 5 : ℝ) * (y - 1) - 9 *
        ((x₀ + v * ((j : ℝ) / 2000)) *
          (v + (2 / 5 : ℝ) * (x₀ + v * ((j : ℝ) / 2000) - 1))) / y) := by
  have hr : Contains rho (2 / 5 : ℝ) := by simpa [rho] using rat_sound (2 / 5)
  have ht : Contains (rat ((j : ℚ) / 2000)) ((j : ℝ) / 2000) := by
    simpa using rat_sound ((j : ℚ) / 2000)
  have hx := add_sound hx₀ (times_sound hv ht)
  have hu := times_sound hx (add_sound hv (times_sound hr (subtract_sound hx (rat_sound 1))))
  have hh := subtract_sound (neg_sound (times_sound hr (subtract_sound hy (rat_sound 1))))
    (divide_sound hY (times_sound (rat_sound 9) hu) hy)
  simpa [field] using hh

/-- Arithmetic of the actual endpoint-flow Taylor update. Analytic remainder
bounds are inequalities about the two real endpoint solutions, not a floating
assumption that the next enclosure is correct. -/
theorem step_endpoint_sound (s : Segment) (j : ℕ) (state : State)
    (fL fU E y : ℝ)
    (hL : Contains (field s j (point state.enclosure.lo)) fL)
    (hU : Contains (field s j (point state.enclosure.hi)) fU)
    (hE : Contains s.error E)
    (hTaylorL : (state.enclosure.lo : ℝ) + (1 / 2000 : ℝ) * fL - E ≤ y)
    (hTaylorU : y ≤ (state.enclosure.hi : ℝ) + (1 / 2000 : ℝ) * fU + E) :
    Contains (step s j state).enclosure y := by
  have hdt : Contains dt (1 / 2000 : ℝ) := by simpa [dt] using rat_sound (1 / 2000)
  have hl := subtract_sound
    (add_sound (point_sound state.enclosure.lo) (times_sound hdt hL)) hE
  have hu := add_sound
    (add_sound (point_sound state.enclosure.hi) (times_sound hdt hU)) hE
  change ((subtract (add (point state.enclosure.lo)
    (times dt (field s j (point state.enclosure.lo)))) s.error).lo : ℝ) ≤ y ∧
    y ≤ ((add (add (point state.enclosure.hi)
      (times dt (field s j (point state.enclosure.hi)))) s.error).hi : ℝ)
  exact ⟨hl.1.trans hTaylorL, hTaylorU.trans hu.2⟩


