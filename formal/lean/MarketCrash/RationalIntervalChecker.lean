def checkpointState (k : ℕ) : State :=
  let p := replayCheckpoints[k]!
  ⟨⟨(p.1 : ℚ) / grid, (p.2 : ℚ) / grid⟩, true⟩

def blockSegment (k : ℕ) : Segment :=
  if k < 46 then prepare (rat 1) plateau (23 / 10)
  else if k < 354 then prepare plateau plateau (77 / 5)
  else if k < 400 then prepare plateau (rat (97 / 100)) (23 / 10)
  else if k < 446 then prepare (rat (97 / 100)) (rat (199 / 200)) (23 / 10)
  else if k < 754 then prepare (rat (199 / 200)) (rat (199 / 200)) (77 / 5)
  else prepare (rat (199 / 200)) (rat (9409 / 10000)) (23 / 10)

def blockStart (k : ℕ) : ℕ :=
  100 * (k - (if k < 46 then 0 else if k < 354 then 46 else if k < 400 then 354
    else if k < 446 then 400 else if k < 754 then 446 else 754))

def checkBlock (k : ℕ) : Bool :=
  let result := run (blockSegment k) 100 (blockStart k) (checkpointState k)
  result.valid && decide (result.enclosure.lo = (checkpointState (k + 1)).enclosure.lo) &&
    decide (result.enclosure.hi = (checkpointState (k + 1)).enclosure.hi)

def allBlocksValid : Bool := (List.range 800).all checkBlock

namespace IntegerReplay

def Q : Int := 10 ^ 32
structure Interval where
  lo : Int
  hi : Int
def ofRatBox (I : Box) : Interval := ⟨⌊I.lo * grid⌋, ⌈I.hi * grid⌉⟩
def lit (q : ℚ) : Interval := ofRatBox (point q)
def plus (I J : Interval) : Interval := ⟨I.lo + J.lo, I.hi + J.hi⟩
def minus (I J : Interval) : Interval := ⟨I.lo - J.hi, I.hi - J.lo⟩
def negate (I : Interval) : Interval := ⟨-I.hi, -I.lo⟩
def ceilDiv (a b : Int) : Int := -((-a) / b)
def multiply (I J : Interval) : Interval :=
  ⟨(min (min (I.lo * J.lo) (I.lo * J.hi)) (min (I.hi * J.lo) (I.hi * J.hi))) / Q,
   ceilDiv (max (max (I.lo * J.lo) (I.lo * J.hi)) (max (I.hi * J.lo) (I.hi * J.hi))) Q⟩
def inverse (I : Interval) : Interval := ⟨Q * Q / I.hi, ceilDiv (Q * Q) I.lo⟩
def quotient (I J : Interval) : Interval := multiply I (inverse J)
structure Segment where
  x₀ : Interval
  velocity : Interval
  error : Interval
def segment (k : ℕ) : Segment :=
  let s := blockSegment k
  ⟨ofRatBox s.x₀, ofRatBox s.velocity, ofRatBox s.error⟩
def field (s : Segment) (j : ℕ) (y : Interval) : Interval :=
  let x := plus s.x₀ (multiply s.velocity (lit ((j : ℚ) / 2000)))
  let u := multiply x (plus s.velocity (multiply (lit (2 / 5)) (minus x (lit 1))))
  minus (negate (multiply (lit (2 / 5)) (minus y (lit 1))))
    (quotient (multiply (lit 9) u) y)
structure State where
  enclosure : Interval
  valid : Bool
def state (k : ℕ) : State :=
  let p := replayCheckpoints[k]!
  ⟨⟨p.1, p.2⟩, true⟩
def step (s : Segment) (j : ℕ) (st : State) : State :=
  let l := Interval.mk st.enclosure.lo st.enclosure.lo
  let u := Interval.mk st.enclosure.hi st.enclosure.hi
  let low := (minus (plus l (multiply (lit (1 / 2000)) (field s j l))) s.error).lo
  let high := (plus (plus u (multiply (lit (1 / 2000)) (field s j u))) s.error).hi
  let motion := (multiply (lit (17 / 10)) (lit (1 / 2000))).hi
  let lb := min st.enclosure.lo low - motion
  let hb := max st.enclosure.hi high + motion
  ⟨⟨low, high⟩, st.valid && decide (low ≤ high) &&
    decide (73 * Q / 100 < st.enclosure.lo) && decide (st.enclosure.hi < 157 * Q / 100) &&
    decide (7 * Q / 10 < lb) && decide (hb < 8 * Q / 5)⟩
def run (s : Segment) : ℕ → ℕ → State → State
  | 0, _, st => st
  | n + 1, j, st => run s n (j + 1) (step s j st)
def checkBlock (k : ℕ) : Bool :=
  let result := run (segment k) 100 (blockStart k) (state k)
  result.valid && decide (result.enclosure.lo = (state (k + 1)).enclosure.lo) &&
    decide (result.enclosure.hi = (state (k + 1)).enclosure.hi)
def allBlocksValid : Bool := (List.range 800).all checkBlock

def view (I : Interval) : Box := ⟨(I.lo : ℚ) / grid, (I.hi : ℚ) / grid⟩

def checkBlockRange (start count : ℕ) : Bool :=
  (List.range count).all (fun k => checkBlock (start + k))

theorem view_multiply (I J : Interval) :
    view (multiply I J) = roundOut grid (mul (view I) (view J)) := by
  let low := min (min (I.lo * J.lo) (I.lo * J.hi)) (min (I.hi * J.lo) (I.hi * J.hi))
  let high := max (max (I.lo * J.lo) (I.lo * J.hi)) (max (I.hi * J.lo) (I.hi * J.hi))
  have hgp : (0 : ℚ) ≤ (grid : ℚ) * grid := by positivity
  have hlo : (mul (view I) (view J)).lo = (low : ℚ) / ((grid : ℚ) * grid) := by
    dsimp [mul, view, low]
    simp only [div_mul_div_comm, min_div_div_right hgp, ← Int.cast_mul, ← Int.cast_min]
  have hhi : (mul (view I) (view J)).hi = (high : ℚ) / ((grid : ℚ) * grid) := by
    dsimp [mul, view, high]
    simp only [div_mul_div_comm, max_div_div_right hgp, ← Int.cast_mul, ← Int.cast_max]
  have hg : (grid : ℚ) ≠ 0 := by exact_mod_cast grid_pos.ne'
  have hl : (low : ℚ) / ((grid : ℚ) * grid) * grid = (low : ℚ) / grid := by
    field_simp; ring
  have hh : (high : ℚ) / ((grid : ℚ) * grid) * grid = (high : ℚ) / grid := by
    field_simp; ring
  change (Box.mk (((low / Q : Int) : ℚ) / grid)
    (((ceilDiv high Q : Int) : ℚ) / grid)) = _
  simp only [roundOut, hlo, hhi, hl, hh, Rat.floor_intCast_div_natCast,
    Rat.ceil_intCast_div_natCast]
  rfl

theorem multiply_sound {I J : Interval} {x y : ℝ}
    (hx : Contains (view I) x) (hy : Contains (view J) y) :
    Contains (view (multiply I J)) (x * y) := by
  rw [view_multiply]
  exact rounded_mul_sound grid grid_pos hx hy

theorem floor_int_div_int (a b : Int) (hb : 0 ≤ b) :
    ⌊((a : ℚ) / (b : ℚ))⌋ = a / b := by
  have hn : ((b.toNat : ℕ) : Int) = b := Int.toNat_of_nonneg hb
  have hq : ((b.toNat : ℕ) : ℚ) = (b : ℚ) := by exact_mod_cast hn
  simpa only [hq, hn] using Rat.floor_intCast_div_natCast a b.toNat

theorem ceil_int_div_int (a b : Int) (hb : 0 ≤ b) :
    ⌈((a : ℚ) / (b : ℚ))⌉ = ceilDiv a b := by
  have hn : ((b.toNat : ℕ) : Int) = b := Int.toNat_of_nonneg hb
  have hq : ((b.toNat : ℕ) : ℚ) = (b : ℚ) := by exact_mod_cast hn
  simpa only [hq, hn, ceilDiv] using Rat.ceil_intCast_div_natCast a b.toNat

theorem view_inverse (I : Interval) (hl : 0 ≤ I.lo) (hh : 0 ≤ I.hi) :
    view (inverse I) = roundOut grid (inv (view I)) := by
  have hquot (a : Int) : 1 / ((a : ℚ) / grid) * grid = ((Q * Q : Int) : ℚ) / a := by
    simp only [one_div_div, Int.cast_mul]
    change (grid : ℚ) / a * grid = (grid : ℚ) * grid / a
    ring
  change (Box.mk (((Q * Q / I.hi : Int) : ℚ) / grid)
    (((ceilDiv (Q * Q) I.lo : Int) : ℚ) / grid)) = _
  simp only [roundOut, inv, view, hquot, floor_int_div_int _ _ hh, ceil_int_div_int _ _ hl]

theorem inverse_sound {I : Interval} {x : ℝ} (hl : 0 < I.lo) (hh : 0 ≤ I.hi)
    (hx : Contains (view I) x) : Contains (view (inverse I)) (1 / x) := by
  rw [view_inverse I hl.le hh]
  apply rounded_inv_sound grid grid_pos _ hx
  change (0 : ℚ) < (I.lo : ℚ) / grid
  apply div_pos
  · exact_mod_cast hl
  · exact_mod_cast grid_pos

theorem view_plus (I J : Interval) : view (plus I J) = add (view I) (view J) := by
  simp [view, plus, add, add_div]

theorem view_minus (I J : Interval) : view (minus I J) = subtract (view I) (view J) := by
  simp [view, minus, subtract, add, neg, sub_div, sub_eq_add_neg, add_div, neg_div]

theorem view_negate (I : Interval) : view (negate I) = neg (view I) := by
  simp [view, negate, neg, neg_div]

theorem lit_sound (q : ℚ) : Contains (view (lit q)) (q : ℝ) :=
  roundOut_sound grid grid_pos (point_sound q)

theorem plus_sound {I J : Interval} {x y : ℝ}
    (hx : Contains (view I) x) (hy : Contains (view J) y) :
    Contains (view (plus I J)) (x + y) := by rw [view_plus]; exact add_sound hx hy

theorem minus_sound {I J : Interval} {x y : ℝ}
    (hx : Contains (view I) x) (hy : Contains (view J) y) :
    Contains (view (minus I J)) (x - y) := by rw [view_minus]; exact subtract_sound hx hy

theorem negate_sound {I : Interval} {x : ℝ} (hx : Contains (view I) x) :
    Contains (view (negate I)) (-x) := by rw [view_negate]; exact neg_sound hx

theorem quotient_sound {I J : Interval} {x y : ℝ} (hl : 0 < J.lo) (hh : 0 ≤ J.hi)
    (hx : Contains (view I) x) (hy : Contains (view J) y) :
    Contains (view (quotient I J)) (x / y) := by
  simpa only [quotient, div_eq_mul_inv, one_div, one_mul] using
    multiply_sound hx (inverse_sound hl hh hy)

theorem field_sound (s : Segment) (j : ℕ) (Y : Interval) (x₀ v y : ℝ)
    (hx₀ : Contains (view s.x₀) x₀) (hv : Contains (view s.velocity) v)
    (hy : Contains (view Y) y) (hl : 0 < Y.lo) (hh : 0 ≤ Y.hi) :
    Contains (view (field s j Y))
      (-(2 / 5 : ℝ) * (y - 1) - 9 *
        ((x₀ + v * ((j : ℝ) / 2000)) *
          (v + (2 / 5 : ℝ) * (x₀ + v * ((j : ℝ) / 2000) - 1))) / y) := by
  have hr := lit_sound (2 / 5)
  have ht : Contains (view (lit ((j : ℚ) / 2000))) ((j : ℝ) / 2000) := by
    simpa using lit_sound ((j : ℚ) / 2000)
  have hx := plus_sound hx₀ (multiply_sound hv ht)
  have hu := multiply_sound hx (plus_sound hv (multiply_sound hr (minus_sound hx (lit_sound 1))))
  have hout := minus_sound (negate_sound (multiply_sound hr (minus_sound hy (lit_sound 1))))
    (quotient_sound hl hh (multiply_sound (lit_sound 9) hu) hy)
  simpa [field] using hout

theorem point_sound (k : Int) : Contains (view ⟨k, k⟩) (((k : ℚ) / grid : ℚ) : ℝ) := by
  exact ⟨le_rfl, le_rfl⟩

theorem step_endpoint_sound (s : Segment) (j : ℕ) (st : State) (fL fU E y : ℝ)
    (hL : Contains (view (field s j ⟨st.enclosure.lo, st.enclosure.lo⟩)) fL)
    (hU : Contains (view (field s j ⟨st.enclosure.hi, st.enclosure.hi⟩)) fU)
    (hE : Contains (view s.error) E)
    (hTaylorL : ((((st.enclosure.lo : ℚ) / grid : ℚ) : ℝ)) +
      (1 / 2000 : ℝ) * fL - E ≤ y)
    (hTaylorU : y ≤ ((((st.enclosure.hi : ℚ) / grid : ℚ) : ℝ)) +
      (1 / 2000 : ℝ) * fU + E) : Contains (view (step s j st).enclosure) y := by
  have hdt : Contains (view (lit (1 / 2000))) (1 / 2000 : ℝ) := by
    simpa using lit_sound (1 / 2000)
  have hl := minus_sound (plus_sound (point_sound st.enclosure.lo) (multiply_sound hdt hL)) hE
  have hu := plus_sound (plus_sound (point_sound st.enclosure.hi) (multiply_sound hdt hU)) hE
  exact ⟨hl.1.trans hTaylorL, hTaylorU.trans hu.2⟩


